# Discord Developer Portal > Bot > Reset Token
DISCORD_TOKEN=replace_with_your_bot_token

# Default destination for every logged action.
LOG_CHANNEL_DEFAULT=123456789012345678

# Optional per-action channel overrides. Keys are listed in docs/ACTIONS.md.
# Any action not listed here uses LOG_CHANNEL_DEFAULT.
LOG_CHANNEL_OVERRIDES='{"voice_join":123456789012345678,"member_role_update":234567890123456789}'

# Optional: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
